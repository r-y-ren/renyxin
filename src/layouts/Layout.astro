---
/**
 * src/layouts/Layout.astro
 * ──────────────────────────────────────────────────────────────────────────────
 * 星穹档案 · 全站公共页面外壳
 * 统一提供：
 *   1. HTML 文档结构（head meta / favicon / title）
 *   2. 全局样式注入（src/styles/globals.css）
 *   3. 三层动态背景：极光光晕（CSS） + Canvas 星野 v2（景深星场/星芒/流星） + 指针光斑
 *   4. 加载动画（R·monogram + 进度条，载入后淡出）
 *   5. 顶部滚动进度条 + 自定义光标 + 星光拖尾（仅精细指针设备）
 *   6. 背景音乐（律动频谱）+ 音效开关 + 星尘挑战小游戏入口 + 回到顶部
 *   7. .reveal 滚动显现观察器
 */
import '../styles/globals.css';
import { getEntry } from 'astro:content';
import StarGame from '../components/StarGame';
import { sfx } from '../scripts/sfx';

interface Props {
  title: string;
}

const { title } = Astro.props;
// 游戏立绘与 Hero 保持同源
const heroEntry = await getEntry('site-info', 'hero');
const characterSrc = heroEntry?.data.characterImage ?? '/pictures/胡桃.png';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/Myfavicon/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/Myfavicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/Myfavicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/Myfavicon/apple-touch-icon.png" />
    <link rel="manifest" href="/Myfavicon/site.webmanifest" />
    <!-- 自托管霞鹜文楷（子集化 woff2，unicode-range 按需加载） -->
    <link rel="stylesheet" href="/fonts/lxgw-wenkai.css" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="千心の鱼的个人星穹档案 —— 技术栈 / 博客 / 成就 / 每日进程" />
    <title>{title}</title>
  </head>
  <body>
    <!-- ═══ 背景层 ═══ -->
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <canvas id="bg-stars" class="bg-stars" aria-hidden="true"></canvas>
    <div class="vignette" aria-hidden="true"></div>
    <div id="cursor-glow" class="cursor-glow" aria-hidden="true"></div>

    <!-- ═══ 加载动画 ═══ -->
    <div id="preloader" class="preloader" aria-hidden="true">
      <div>
        <div class="preloader-mono">R<span class="preloader-dot">.</span></div>
        <div class="preloader-bar"><i></i></div>
      </div>
    </div>

    <!-- ═══ 滚动进度 + 自定义光标 ═══ -->
    <div id="scroll-progress" aria-hidden="true"></div>
    <div id="cursor-dot" class="cursor-dot" aria-hidden="true"></div>
    <div id="cursor-ring" class="cursor-ring" aria-hidden="true"></div>

    <!-- ═══ 页面内容 ═══ -->
    <div class="page" id="page">
      <slot />
    </div>

    <!-- ═══ 背景音乐 + 悬浮操作 ═══ -->
    <audio id="bg-music" src="/music/music1.mp3" loop preload="auto"></audio>
    <div class="fab-cluster">
      <button id="game-btn" class="fab fab-game" aria-label="打开星尘挑战小游戏" title="星尘挑战 ✦">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2.6l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.1l6.1-.9L12 2.6z"/>
        </svg>
      </button>
      <button id="sfx-btn" class="fab" aria-label="关闭音效" title="音效已开启">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 5L6 9H2v6h4l5 4V5z"/>
          <path class="sfx-wave" d="M15.5 8.5a5 5 0 010 7M18.5 5.5a9 9 0 010 13"/>
          <path class="sfx-off" d="M17 9l5 6M22 9l-5 6"/>
        </svg>
      </button>
      <button id="music-btn" class="fab" aria-label="播放背景音乐" title="播放背景音乐">
        <span id="music-eq" class="eq paused" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </button>
      <button id="back-top" class="fab" aria-label="回到顶部" title="回到顶部">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <!-- ═══ 星尘挑战小游戏（彩蛋） ═══ -->
    <StarGame client:load characterSrc={characterSrc} />
  </body>
</html>

<script>
  import { sfx } from '../scripts/sfx';

  const prefersReduced = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  // ── 1. 加载动画：页面载入后淡出 ──────────────────────────────────────────
  const preloader = document.getElementById('preloader');
  const page = document.getElementById('page');
  const hidePreloader = () => {
    if (!preloader) return;
    preloader.classList.add('is-done');
    page?.classList.add('is-ready');
  };
  if (document.readyState === 'complete') {
    setTimeout(hidePreloader, 500);
  } else {
    window.addEventListener('load', () => setTimeout(hidePreloader, 500));
  }
  setTimeout(hidePreloader, 2800); // 兜底：最迟 2.8s 放行

  // ── 2. 背景星穹：Three.js 3D 星野优先，失败/减弱动效时降级 2D 星野 ────────
  const canvas = document.getElementById('bg-stars');
  if (canvas && canvas instanceof HTMLCanvasElement) {
    const fallback2D = () =>
      import('../scripts/starfield2d').then(({ initStarfield2D }) =>
        initStarfield2D(canvas, prefersReduced),
      );
    if (prefersReduced) {
      void fallback2D();
    } else {
      import('../scripts/universe3d')
        .then(({ initUniverse3D }) => {
          if (!initUniverse3D()) void fallback2D();
        })
        .catch(() => void fallback2D());
    }
  }

  // ── 3. 指针光斑 + 自定义光标（仅精细指针 / 非减弱动效）────────────────────
  if (finePointer && !prefersReduced) {
    document.documentElement.classList.add('has-custom-cursor');
    const dot = document.getElementById('cursor-dot');
    const ring = document.getElementById('cursor-ring');
    const glow = document.getElementById('cursor-glow');
    let mx = window.innerWidth / 2;
    let my = window.innerHeight / 2;
    let rx = mx;
    let ry = my;

    window.addEventListener('mousemove', (e) => {
      mx = e.clientX;
      my = e.clientY;
      if (dot) dot.style.transform = `translate(${mx}px, ${my}px) translate(-50%, -50%)`;
      if (glow) glow.style.transform = `translate(${mx}px, ${my}px) translate(-50%, -50%)`;
    });

    const follow = () => {
      rx += (mx - rx) * 0.16;
      ry += (my - ry) * 0.16;
      if (ring) ring.style.transform = `translate(${rx}px, ${ry}px) translate(-50%, -50%)`;
      requestAnimationFrame(follow);
    };
    requestAnimationFrame(follow);

    document.addEventListener('mouseover', (e) => {
      const target = e.target as Element | null;
      if (target?.closest('a, button, [data-cursor], input, textarea, select')) {
        ring?.classList.add('is-active');
      }
    });
    document.addEventListener('mouseout', (e) => {
      const target = e.target as Element | null;
      if (target?.closest('a, button, [data-cursor], input, textarea, select')) {
        ring?.classList.remove('is-active');
      }
    });

    // ── 3b. 星光拖尾：鼠标移动时洒落细碎星光（限量，动画结束即销毁）─────────
    let trailX = 0;
    let trailY = 0;
    let trailT = 0;
    window.addEventListener('mousemove', (e) => {
      const now = performance.now();
      const dx = e.clientX - trailX;
      const dy = e.clientY - trailY;
      if (now - trailT < 46 || dx * dx + dy * dy < 300) return;
      trailT = now;
      trailX = e.clientX;
      trailY = e.clientY;
      if (document.querySelectorAll('.sparkle').length > 22) return;
      const sp = document.createElement('span');
      sp.className = 'sparkle';
      sp.textContent = '✦';
      sp.style.left = `${e.clientX + (Math.random() * 18 - 9)}px`;
      sp.style.top = `${e.clientY + (Math.random() * 18 - 9)}px`;
      sp.style.fontSize = `${8 + Math.random() * 8}px`;
      sp.style.animationDuration = `${0.55 + Math.random() * 0.5}s`;
      if (Math.random() < 0.35) sp.style.setProperty('--spark', 'var(--cyan)');
      document.body.appendChild(sp);
      sp.addEventListener('animationend', () => sp.remove());
    });
  }

  // ── 4. 滚动进度条 + 回到顶部 ─────────────────────────────────────────────
  const progress = document.getElementById('scroll-progress');
  const backTop = document.getElementById('back-top');
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? (window.scrollY / max) * 100 : 0;
      if (progress) progress.style.width = p + '%';
      if (backTop) backTop.classList.toggle('is-visible', window.scrollY > 560);
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  backTop?.addEventListener('click', () =>
    window.scrollTo({ top: 0, behavior: 'smooth' }),
  );

  // ── 5. 背景音乐（律动频谱）───────────────────────────────────────────────
  const audio = document.getElementById('bg-music') as HTMLAudioElement | null;
  const musicBtn = document.getElementById('music-btn') as HTMLButtonElement | null;
  const eq = document.getElementById('music-eq');

  const syncMusic = () => {
    if (!audio || !musicBtn || !eq) return;
    const playing = !audio.paused && !audio.ended;
    eq.classList.toggle('paused', !playing);
    const label = playing ? '暂停背景音乐' : '播放背景音乐';
    musicBtn.title = label;
    musicBtn.setAttribute('aria-label', label);
  };
  audio?.addEventListener('play', syncMusic);
  audio?.addEventListener('pause', syncMusic);
  musicBtn?.addEventListener('click', () => {
    if (!audio) return;
    if (audio.paused) {
      audio.play().catch(() => {});
    } else {
      audio.pause();
    }
  });
  // 首次用户交互后尝试自动播放
  document.addEventListener(
    'click',
    () => {
      if (audio && audio.paused) {
        audio.play().catch(() => {});
      }
    },
    { once: true },
  );

  // ── 6b. 小游戏入口 + 音效开关 + 按钮音效 ─────────────────────────────────
  const gameBtn = document.getElementById('game-btn');
  const sfxBtn = document.getElementById('sfx-btn');

  gameBtn?.addEventListener('click', () => {
    sfx.unlock();
    sfx.click();
    (window as any).__openStarGame?.();
    document.dispatchEvent(new CustomEvent('star-game:open'));
  });

  const syncSfxBtn = () => {
    if (!sfxBtn) return;
    const off = sfx.muted;
    sfxBtn.classList.toggle('is-muted', off);
    sfxBtn.title = off ? '音效已关闭' : '音效已开启';
    sfxBtn.setAttribute('aria-label', off ? '开启音效' : '关闭音效');
  };
  sfxBtn?.addEventListener('click', () => {
    sfx.unlock();
    sfx.toggleMuted();
    syncSfxBtn();
    if (!sfx.muted) sfx.pop();
  });
  syncSfxBtn();

  musicBtn?.addEventListener('click', () => sfx.click());
  backTop?.addEventListener('click', () => sfx.click());

  // ── 6. .reveal 滚动显现观察器 ────────────────────────────────────────────
  const revealObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
  );
  document
    .querySelectorAll('.reveal')
    .forEach((el) => revealObserver.observe(el));
</script>
