---
/**
 * src/pages/index.astro
 * ──────────────────────────────────────────────────────────────────────────────
 * 星穹档案 · 首页
 * 叙事结构（单页滚动）：
 *   首页     → Hero 英雄区（逐字标题 / 打字机 / 磁吸按钮 / 立绘传送门 / 计数）
 *   跑马灯   → 技能滚动字幕
 *   01 档案   → DraggableCharacter（pretext 文字绕排 + 可拖拽立绘）
 *   02 进程   → ContributionGraph 热力图 + 最近日志速览
 *   03 文章   → BlogGrid 博客卡片
 *   04 星图   → SkillConstellation 技能星座
 *   05 成就   → AchievementGrid 成就徽章
 *   06 未来   → DraggableOutlook 展望卡片 + 联系方式
 *   页脚     → 版权 / 链接
 */
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import Nav from '../components/Nav';
import Hero from '../components/Hero';
import DraggableCharacter from '../components/DraggableCharacter';
import SkillConstellation from '../components/SkillConstellation';
import ContributionGraph from '../components/ContributionGraph';
import BlogGrid from '../components/BlogGrid';
import AchievementGrid from '../components/AchievementGrid';
import DraggableOutlook from '../components/DraggableOutlook';
import type { DailyLogEntry } from '../components/ContributionGraph';
import { marked } from 'marked';

// ── ① 博客与成就 ─────────────────────────────────────────────────────────────
const blogPosts = await getCollection('blog');
const achievements = await getCollection('achievements');
const sortedPosts = blogPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const sortedAchievements = achievements.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// ── ② 技能 ───────────────────────────────────────────────────────────────────
const skillEntries = await getCollection('skills');
const skillsData = skillEntries.map((e) => ({
  name: e.data.name,
  proficiency: e.data.proficiency,
  class: e.data.class,
  description: e.data.description,
}));

// ── ③ 站点配置 ───────────────────────────────────────────────────────────────
const heroEntry = await getEntry('site-info', 'hero');
const outlookEntry = await getEntry('site-info', 'outlook');
const footerEntry = await getEntry('site-info', 'footer');
const introHtml = marked.parse(heroEntry!.body) as string;
const outlookHtml = marked.parse(outlookEntry!.body) as string;
const footerLinks = footerEntry?.data.links ?? [];
const footerCopyright = footerEntry?.data.copyright ?? '© 2024';

// Hero 简介：取正文纯文本前 110 字
const heroPlain = heroEntry!.body
  .replace(/^---[\s\S]*?---\s*/, '')
  .replace(/[#*_~>|]/g, '')
  .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
  .replace(/\s+/g, ' ')
  .trim();
const heroIntro = heroPlain.slice(0, 110) + '…';

// ── ④ 每日日志 ───────────────────────────────────────────────────────────────
const rawLogs = await getCollection('daily-log');
const dailyLogs: DailyLogEntry[] = rawLogs.map((entry) => ({
  slug: entry.slug,
  date: (entry.data.date as Date).toISOString().slice(0, 10),
  title: entry.data.title,
}));
const sortedLogs = [...dailyLogs].sort((a, b) => b.date.localeCompare(a.date));

// ── ⑤ 博客文章（含渲染后的 HTML 与摘要）────────────────────────────────────
interface BlogPostWithContent {
  slug: string;
  data: { title: string; date: Date; tags: string[]; coverImage?: string };
  html: string;
  excerpt: string;
}
const postsWithContent: BlogPostWithContent[] = sortedPosts.map((post) => {
  const body = post.body.replace(/^---[\s\S]*?---\s*/, '');
  const textContent = body
    .replace(/#+\s/g, '')
    .replace(/[*_]/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .trim();
  const excerpt = textContent.substring(0, 150) + '...';
  const html = marked(body) as string;
  return { slug: post.slug, data: post.data, html, excerpt };
});

// ── ⑥ 导航数据 ───────────────────────────────────────────────────────────────
const navItems = [
  { id: 'home', label: '首页' },
  { id: 'about', label: '档案' },
  { id: 'journey', label: '进程' },
  { id: 'blog', label: '文章', num: sortedPosts.length },
  { id: 'skills', label: '星图', num: skillsData.length },
  { id: 'achievements', label: '成就', num: achievements.length },
  { id: 'future', label: '未来' },
];
---

<Layout title="Renyxin's digital world">
  <Nav client:load items={navItems} />

  <main>
    <!-- ═══ 首页 · 英雄区 ═══ -->
    <section id="home">
      <div class="section-inner">
        <Hero
          client:load
          title={heroEntry!.data.title}
          subtitle={heroEntry!.data.subtitle ?? '努力学习，好好吃饭の二次元~'}
          intro={heroIntro}
          stats={{
            posts: sortedPosts.length,
            achievements: achievements.length,
            skills: skillsData.length,
            logs: dailyLogs.length,
          }}
          links={footerLinks}
          imageSrc={heroEntry!.data.characterImage ?? '/pictures/胡桃.png'}
          imageAlt="角色立绘"
        />
      </div>
    </section>

    <!-- ═══ 技能跑马灯 ═══ -->
    <div class="marquee my-10" aria-label="技能列表">
      <div class="marquee-track">
        {[0, 1].map((dup) => (
          <div key={dup} class="flex items-center" aria-hidden={dup === 1}>
            {skillsData.map((s) => (
              <span key={dup + '-' + s.name} class="marquee-item">
                {s.name}
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- ═══ 01 · 档案 ═══ -->
    <section id="about" class="section">
      <div class="section-inner">
        <div class="section-head reveal">
          <span class="section-index">01</span>
          <h2 class="section-title">
            档案 <span class="en">Profile</span>
          </h2>
          <div class="section-line"></div>
          <span class="section-coord">RA 18h 36m · DEC +38°</span>
        </div>
        <div class="reveal" style="--d:.08s">
          <DraggableCharacter
            client:load
            title={heroEntry!.data.title}
            imageSrc={heroEntry!.data.characterImage ?? '/pictures/胡桃.png'}
            imageAlt={'立绘'}
            markdownHtml={introHtml}
          />
        </div>
      </div>
    </section>

    <!-- ═══ 02 · 进程 ═══ -->
    <section id="journey" class="section">
      <div class="section-inner">
        <div class="section-head reveal">
          <span class="section-index">02</span>
          <h2 class="section-title">
            进程 <span class="en">Journey</span>
          </h2>
          <div class="section-line"></div>
          <span class="section-coord">RA 05h 55m · DEC +07°</span>
        </div>
        <div id="contribution" class="reveal journey-graph">
          <ContributionGraph client:load logs={dailyLogs} />
        </div>
        <div class="log-chips reveal" style="--d:.14s">
          {sortedLogs.slice(0, 8).map((log) => (
            <a class="log-chip" href={'/daily-log/' + log.slug}>
              <span class="log-chip-date">{log.date.replace(/-/g, '.')}</span>
              <span class="log-chip-title">{log.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ 03 · 文章 ═══ -->
    <section id="blog" class="section">
      <div class="section-inner">
        <div class="section-head reveal">
          <span class="section-index">03</span>
          <h2 class="section-title">
            文章 <span class="en">Blog</span>
          </h2>
          <div class="section-line"></div>
          <span class="section-coord">RA 06h 45m · DEC −16°</span>
        </div>
        <div class="reveal" style="--d:.08s">
          <BlogGrid client:load posts={postsWithContent} />
        </div>
      </div>
    </section>

    <!-- ═══ 04 · 星图 ═══ -->
    <section id="skills" class="section">
      <div class="section-inner">
        <div class="section-head reveal">
          <span class="section-index">04</span>
          <h2 class="section-title">
            星图 <span class="en">Constellation</span>
          </h2>
          <div class="section-line"></div>
          <span class="section-coord">RA 20h 41m · DEC +45°</span>
        </div>
        <div class="reveal" style="--d:.08s">
          <SkillConstellation client:load skills={skillsData} width={900} height={560} />
        </div>
      </div>
    </section>

    <!-- ═══ 05 · 成就 ═══ -->
    <section id="achievements" class="section">
      <div class="section-inner">
        <div class="section-head reveal">
          <span class="section-index">05</span>
          <h2 class="section-title">
            成就 <span class="en">Achievements</span>
          </h2>
          <div class="section-line"></div>
          <span class="section-coord">RA 14h 15m · DEC +19°</span>
        </div>
        <div class="reveal" style="--d:.08s">
          <AchievementGrid
            client:load
            achievements={sortedAchievements.map((a) => ({
              slug: a.slug,
              data: a.data,
              body: a.body ?? '',
            }))}
          />
        </div>
      </div>
    </section>

    <!-- ═══ 06 · 未来 ═══ -->
    <section id="future" class="section">
      <div class="section-inner">
        <div class="section-head reveal">
          <span class="section-index">06</span>
          <h2 class="section-title">
            未来 <span class="en">Dream</span>
          </h2>
          <div class="section-line"></div>
          <span class="section-coord">RA 19h 50m · DEC +08°</span>
        </div>
        <div class="reveal dream-card" style="--d:.08s">
          <DraggableOutlook
            client:load
            title={outlookEntry!.data.title}
            subtitle={outlookEntry!.data.subtitle}
            htmlContent={outlookHtml}
          />
        </div>

        <!-- 联系方式 -->
        <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-4" style="--d:.16s">
          <span class="text-dim text-sm tracking-[0.3em]">CONTACT</span>
          {footerLinks.map((link) => (
            <a
              key={link.href}
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="btn btn-ghost !py-2.5 !px-7 !text-sm"
            >
              {link.label}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <path d="M7 17L17 7M9 7h8v8" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- ═══ 页脚 ═══ -->
  <script>
    // 彩蛋：页脚星星连点 5 次提示，10 次触发全屏流星雨
    const footerStar = document.querySelector('.footer-star');
    let eggClicks = 0;
    let eggToastTimer: number | undefined;

    function showEggToast(msg: string) {
      let toast = document.getElementById('egg-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'egg-toast';
        toast.className = 'egg-toast';
        document.body.appendChild(toast);
      }
      toast.textContent = msg;
      toast.classList.add('is-show');
      window.clearTimeout(eggToastTimer);
      eggToastTimer = window.setTimeout(() => toast!.classList.remove('is-show'), 2600);
    }

    if (footerStar) {
      footerStar.addEventListener('click', () => {
        eggClicks += 1;
        if (eggClicks === 5) {
          showEggToast('再点 5 下，有惊喜 ✦');
        } else if (eggClicks >= 10) {
          eggClicks = 0;
          (window as any).__meteorShower?.();
          showEggToast('✦ 星雨已至，愿你今夜好梦 ✦');
        }
      });
    }
  </script>

  <footer class="site-footer" id="contact">
    <div class="site-footer-inner">
      <div class="footer-sign">
        千心の鱼 <em>✦</em> 星穹档案
      </div>
      <nav class="footer-links" aria-label="社交链接">
        {footerLinks.map((link) => (
          <a
            key={link.href}
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
      <p class="footer-copy">
        {footerCopyright} · 手写于星空之下{' '}
        <span class="footer-star" aria-hidden="true">✦</span>
      </p>
    </div>
  </footer>
</Layout>
